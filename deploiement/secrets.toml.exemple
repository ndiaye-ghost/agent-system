# Connexion avec les comptes Microsoft de l'entreprise (Entra ID / Azure AD).
# Copier ce fichier en « secrets.toml » à côté de docker-compose.yml, remplir les valeurs,
# puis décommenter la ligne correspondante dans docker-compose.yml.
# Ne jamais versionner le fichier secrets.toml rempli.

[auth]
# Adresse de la page suivie de /oauth2callback (doit être déclarée dans l'application Entra ID)
redirect_uri = "https://assistant-surete.mon-entreprise.local/oauth2callback"
# Longue chaîne aléatoire, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "A_REMPLACER"
client_id = "A_REMPLACER"
client_secret = "A_REMPLACER"
server_metadata_url = "https://login.microsoftonline.com/ID_DU_TENANT/v2.0/.well-known/openid-configuration"
